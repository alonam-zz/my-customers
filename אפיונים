דוח סגירה, וזמן ממוצע לסגירה , לפי סוגי תקלות:
SELECT 
  type,
  AVG(TIMESTAMPDIFF(HOUR, created_at, closed_at)) AS avg_close_hours
FROM service_calls 
WHERE status = 'סגורה'
  AND closed_at IS NOT NULL
GROUP BY type;

דוח קריאות לפי לקוח:
לקוח , סה"כ קריאות, פתוחות, סגורות, , תלונות, דחופות ואחרונה
SELECT 
  customer_id,
  COUNT(*) AS total_calls,
  SUM(status != 'סגורה') AS open_calls,
  SUM(type = 'תלונה') AS complaints,
  MAX(created_at) AS last_call_date
FROM service_calls
GROUP BY customer_id
ORDER BY total_calls DESC;

