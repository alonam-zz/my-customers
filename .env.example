# =============================================================================
# Environment variables for my-customers
# -----------------------------------------------------------------------------
# Copy this file to `.env` (which is gitignored) and fill in real values:
#     cp .env.example .env
# Docker Compose and the server both read the `.env` file at the project root.
# =============================================================================

# ----- Server -----
# Port the API listens on (Docker Compose sets this to 3000 for the container).
PORT=3000
NODE_ENV=development

# Secret used to sign auth JWTs — use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Name of the auth cookie.
AUTH_COOKIE_NAME=token

# Allowed CORS origin(s) for the client (comma-separated). Defaults to the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# Public base URL of the API (used to build absolute links).
PUBLIC_BASE_URL=http://localhost:3000

# Base URL of the client app — used to build activation/reset links in emails.
DOMAIN=http://localhost:5173

# ----- Database (MySQL) -----
# Use 127.0.0.1 when running the server locally; use `db` when running via Docker Compose.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=customer_service
DB_USER=app_user
DB_PASSWORD=change-me

# ----- Email / SMTP -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password-or-app-password
# "From" address on outgoing mail (defaults to SMTP_USER if unset).
MAIL_FROM=no-reply@example.com
# Recipient for system notifications.
MAIL_TO=admin@example.com

# ----- Docker Compose -----
# Optional: caps how many images build in parallel.
COMPOSE_PARALLEL_LIMIT=2
